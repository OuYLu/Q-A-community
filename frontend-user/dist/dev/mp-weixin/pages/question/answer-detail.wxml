<view class="page"><view wx:if="{{a}}" class="state">加载中...</view><view wx:elif="{{b}}" class="state">{{c}}</view><view wx:else><view class="question-title" bindtap="{{e}}">问题：{{d}}</view><view class="answer-card"><view class="more-btn" catchtap="{{f}}">...</view><view class="author-row" catchtap="{{m}}"><image wx:if="{{g}}" class="avatar" src="{{h}}" mode="aspectFill"/><view wx:else class="avatar-fallback">{{i}}</view><view class="author-info"><view class="author-name">{{j}} <text wx:if="{{k}}" class="best-tag">最佳回答</text></view><view class="author-time">{{l}}</view></view></view><view class="content">{{n}}</view><view wx:if="{{o}}" class="images-wrap"><image wx:for="{{p}}" wx:for-item="url" wx:key="a" class="img" src="{{url.b}}" mode="aspectFill" bindtap="{{url.c}}"/></view><view class="answer-actions"><view class="{{['mini-action', 'like-btn', r && 'active']}}" bindtap="{{s}}"><text class="mini-icon">👍</text><text>{{q}}</text></view><view class="{{['mini-action', v && 'active']}}" bindtap="{{w}}"><text class="mini-icon">♥</text><text>{{t}}</text></view><view class="mini-action"><text class="mini-icon">💬</text><text>{{x}}</text></view></view></view><view class="section-title">评论 ({{y}})</view><view wx:if="{{z}}" class="empty">还没有评论</view><view wx:for="{{A}}" wx:for-item="root" wx:key="k" class="comment-card"><view class="comment-main"><view class="author-row" catchtap="{{root.g}}"><image wx:if="{{root.a}}" class="avatar mini" src="{{root.b}}" mode="aspectFill"/><view wx:else class="avatar-fallback mini">{{root.c}}</view><view class="author-info"><view class="author-name small">{{root.d}}</view><view class="author-time">{{root.e}}</view></view><view class="reply-btn" catchtap="{{root.f}}">↩</view></view><view class="comment-content">{{root.h}}</view></view><view wx:if="{{root.i}}" class="child-list"><view wx:for="{{root.j}}" wx:for-item="child" wx:key="i" class="child-item"><view class="author-row" catchtap="{{child.g}}"><image wx:if="{{child.a}}" class="avatar mini" src="{{child.b}}" mode="aspectFill"/><view wx:else class="avatar-fallback mini">{{child.c}}</view><view class="author-info"><view class="author-name small">{{child.d}}</view><view class="author-time">{{child.e}}</view></view><view class="reply-btn" catchtap="{{child.f}}">↩</view></view><view class="comment-content">{{child.h}}</view></view></view></view><view class="comment-input-wrap"><view wx:if="{{B}}" class="replying"><text>回复 {{C}}</text><text class="cancel-reply" bindtap="{{D}}">取消</text></view><input class="comment-input" placeholder="{{E}}" value="{{F}}" bindinput="{{G}}"/><button class="post-btn" bindtap="{{I}}">{{H}}</button></view></view></view>