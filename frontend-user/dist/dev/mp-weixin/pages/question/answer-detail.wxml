<view class="page"><view wx:if="{{a}}" class="state">加载中...</view><view wx:elif="{{b}}" class="state">{{c}}</view><view wx:else><view class="question-title">问题：{{d}}</view><view class="answer-card"><view class="more-btn" catchtap="{{e}}">...</view><view class="author-row" catchtap="{{l}}"><image wx:if="{{f}}" class="avatar" src="{{g}}" mode="aspectFill"/><view wx:else class="avatar-fallback">{{h}}</view><view class="author-info"><view class="author-name">{{i}} <text wx:if="{{j}}" class="best-tag">最佳回答</text></view><view class="author-time">{{k}}</view></view></view><view class="content">{{m}}</view><view wx:if="{{n}}" class="images-wrap"><image wx:for="{{o}}" wx:for-item="url" wx:key="a" class="img" src="{{url.b}}" mode="aspectFill" bindtap="{{url.c}}"/></view><view class="answer-actions"><view class="{{['mini-action', 'like-btn', q && 'active']}}" bindtap="{{r}}"><text class="mini-icon">赞</text><text>{{p}}</text></view><view class="{{['mini-action', t && 'active']}}" bindtap="{{v}}"><text class="mini-icon">藏</text><text>{{s}}</text></view><view class="mini-action"><text class="mini-icon">评</text><text>{{w}}</text></view></view></view><view class="section-title">评论 ({{x}})</view><view wx:if="{{y}}" class="empty">还没有评论</view><view wx:for="{{z}}" wx:for-item="root" wx:key="k" class="comment-card"><view class="comment-main"><view class="author-row" catchtap="{{root.g}}"><image wx:if="{{root.a}}" class="avatar mini" src="{{root.b}}" mode="aspectFill"/><view wx:else class="avatar-fallback mini">{{root.c}}</view><view class="author-info"><view class="author-name small">{{root.d}}</view><view class="author-time">{{root.e}}</view></view><view class="reply-btn" catchtap="{{root.f}}">↩</view></view><view class="comment-content">{{root.h}}</view></view><view wx:if="{{root.i}}" class="child-list"><view wx:for="{{root.j}}" wx:for-item="child" wx:key="i" class="child-item"><view class="author-row" catchtap="{{child.g}}"><image wx:if="{{child.a}}" class="avatar mini" src="{{child.b}}" mode="aspectFill"/><view wx:else class="avatar-fallback mini">{{child.c}}</view><view class="author-info"><view class="author-name small">{{child.d}}</view><view class="author-time">{{child.e}}</view></view><view class="reply-btn" catchtap="{{child.f}}">↩</view></view><view class="comment-content">{{child.h}}</view></view></view></view><view class="comment-input-wrap"><view wx:if="{{A}}" class="replying"><text>回复 {{B}}</text><text class="cancel-reply" bindtap="{{C}}">取消</text></view><input class="comment-input" placeholder="{{D}}" value="{{E}}" bindinput="{{F}}"/><button class="post-btn" bindtap="{{H}}">{{G}}</button></view></view></view>